{
  "expo": {
    "name": "BellezaAI",
    "slug": "bellezaai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bellezaai.app"
    },
    "android": {
      "package": "com.bellezaai.app"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "BellezaAI necesita acceso a tus fotos para publicar trabajos del salón.",
          "cameraPermission": "BellezaAI necesita acceso a la cámara para añadir fotos del salón."
        }
      ]
    ]
  }
}
